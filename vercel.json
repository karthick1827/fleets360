{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "_acl/**, _acl-output/**, tools/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|markdown\\.html|markdown/|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
