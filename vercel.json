{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/markdown/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{tools/**,_acl/**,_acl-output/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/atlassian/config",
      "destination": "/api/atlassian-config"
    },
    {
      "source": "/api/atlassian/discover",
      "destination": "/api/atlassian-discover"
    },
    {
      "source": "/api/atlassian/sync-jira",
      "destination": "/api/atlassian-sync-jira"
    },
    {
      "source": "/api/atlassian/pull-jira",
      "destination": "/api/atlassian-pull-jira"
    },
    {
      "source": "/api/atlassian/sync-confluence",
      "destination": "/api/atlassian-sync-confluence"
    },
    {
      "source": "/api/atlassian/pull-confluence",
      "destination": "/api/atlassian-pull-confluence"
    },
    {
      "source": "/api/atlassian/sync-history",
      "destination": "/api/atlassian-sync-history"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|markdown|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
